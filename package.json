{
  "name": "demo3",
  "version": "1.0.0",
  "description": "Car review backend",
  "main": "src/app.js",
  "scripts": {
    "test": "jest --forceExit",
    "start": "node src/server.js"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "babel-jest": "^30.4.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^6.3.4"
  },
  "jest": {
    "projects": [
      {
        "displayName": "backend",
        "testEnvironment": "node",
        "testMatch": ["<rootDir>/tests/cars.test.js"]
      },
      {
        "displayName": "frontend",
        "testEnvironment": "jsdom",
        "testMatch": ["<rootDir>/tests/CarDetail.test.jsx"],
        "transform": {
          "^.+\\.[jt]sx?$": "babel-jest"
        },
        "setupFilesAfterEnv": ["@testing-library/jest-dom"]
      }
    ]
  }
}
