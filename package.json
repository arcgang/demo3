{
  "name": "demo3",
  "version": "1.0.0",
  "description": "Car review backend",
  "main": "src/app.js",
  "scripts": {
    "test": "jest --forceExit",
    "start": "node src/server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-jest": "^30.4.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "supertest": "^6.3.4",
    "vite": "^6.3.5"
  },
  "jest": {
    "projects": [
      {
        "displayName": "backend",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/cars.test.js",
          "<rootDir>/tests/car_reviews.test.js",
          "<rootDir>/tests/migration_reviews.test.js",
          "<rootDir>/tests/reviews_post.test.js"
        ]
      },
      {
        "displayName": "frontend",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/tests/CarDetail.test.jsx",
          "<rootDir>/tests/CarDetailReviewSubmission.test.jsx"
        ],
        "transform": {
          "^.+\\.[jt]sx?$": "babel-jest"
        },
        "setupFilesAfterEnv": [
          "@testing-library/jest-dom",
          "<rootDir>/tests/setupLocation.js"
        ]
      }
    ]
  }
}
